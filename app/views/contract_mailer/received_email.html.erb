<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background:#eef8ff;margin:0;padding:24px 12px;font-family:'Hiragino Kaku Gothic ProN','Hiragino Sans','Yu Gothic',Meiryo,sans-serif;">
  <tr>
    <td align="center">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600" style="max-width:600px;width:100%;background:#ffffff;border:1px solid #cfe5f7;border-radius:18px;overflow:hidden;">
        <tr>
          <td style="background:#06224f;color:#ffffff;padding:20px 24px;">
            <p style="margin:0 0 6px;font-size:12px;font-weight:800;letter-spacing:.08em;">KURASERA 家事代行</p>
            <h1 style="margin:0;font-size:22px;line-height:1.4;">送信が完了しました</h1>
            <p style="margin:8px 0 0;font-size:14px;">内容を info@j-work.jp に通知しました。</p>
          </td>
        </tr>
        <tr>
          <td style="padding:20px 24px 8px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
              <tr>
                <td style="width:33%;padding:8px;background:#f4f8fc;border-radius:10px;color:#06224f;font-size:12px;font-weight:800;">1 条件を入力</td>
                <td style="width:8px;"></td>
                <td style="width:33%;padding:8px;background:#f4f8fc;border-radius:10px;color:#06224f;font-size:12px;font-weight:800;">2 単価を確認</td>
                <td style="width:8px;"></td>
                <td style="width:33%;padding:8px;background:#e8f4ff;border-radius:10px;color:#06224f;font-size:12px;font-weight:800;">3 LINEで申込</td>
              </tr>
            </table>
          </td>
        </tr>
        <tr>
          <td style="padding:8px 24px 20px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background:#ecf8ef;border-radius:12px;">
              <tr>
                <td style="padding:16px;">
                  <p style="margin:0 0 8px;color:#14532d;font-size:18px;font-weight:800;">担当者へ通知済みです</p>
                  <p style="margin:0;color:#14532d;font-size:14px;font-weight:600;line-height:1.6;">ご入力内容を info@j-work.jp に通知しました。</p>
                </td>
              </tr>
            </table>
          </td>
        </tr>
        <% if @contract.inquiry_hourly_estimate %>
        <tr>
          <td style="padding:0 24px 20px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background:#f0f7ff;border:1px solid #cfe3f8;border-radius:12px;">
              <tr>
                <td style="padding:16px;">
                  <p style="margin:0 0 4px;color:#06224f;font-size:12px;font-weight:800;">時間単価</p>
                  <p style="margin:0;color:#06224f;font-size:28px;font-weight:800;line-height:1.2;">
                    <%= ActiveSupport::NumberHelper.number_to_delimited(@contract.inquiry_hourly_estimate) %><span style="font-size:14px;">円〜／時間</span>
                  </p>
                  <p style="margin:8px 0 0;color:#06224f;font-size:13px;font-weight:700;"><%= @contract.inquiry_area_label %></p>
                  <% if @contract.inquiry_monthly_estimate %>
                  <p style="margin:4px 0 0;color:#06224f;font-size:13px;font-weight:700;">月額 <%= ActiveSupport::NumberHelper.number_to_delimited(@contract.inquiry_monthly_estimate) %>円〜（4週換算）</p>
                  <% end %>
                  <p style="margin:8px 0 0;color:#475569;font-size:12px;">支払いはクレジットカードです。交通費は実費です。</p>
                </td>
              </tr>
            </table>
          </td>
        </tr>
        <% end %>
        <tr>
          <td style="padding:0 24px 24px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border:1px solid #cfe5f7;border-radius:12px;">
              <tr>
                <td style="padding:16px 16px 4px;color:#06224f;font-size:13px;font-weight:800;">お客様情報</td>
              </tr>
              <% [
                ['お名前', [@contract.company, @contract.name].compact.reject { |v| v.to_s.strip.empty? }.join(' ')],
                ['電話番号', @contract.tel],
                ['ご住所', @contract.address],
                ['メールアドレス', @contract.email],
                ['週ご利用希望日数・時間', @contract.service],
                ['開始希望', @contract.period],
                ['その他ご要望', @contract.message]
              ].each do |label, value| %>
              <tr>
                <td style="padding:8px 16px;border-top:1px solid #eef2f7;">
                  <p style="margin:0 0 2px;color:#64748b;font-size:11px;font-weight:800;"><%= label %></p>
                  <p style="margin:0;color:#071c43;font-size:14px;font-weight:700;white-space:pre-wrap;"><%= value.to_s.strip.empty? ? '—' : value %></p>
                </td>
              </tr>
              <% end %>
            </table>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
