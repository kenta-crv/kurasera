meta charset="UTF-8"
meta name="viewport" content="width=device-width, initial-scale=1.0"

= csrf_meta_tags
= csp_meta_tag

- home_care_lp = controller_name == "pages" && action_name == "home_care"
- lp_stylesheet = home_care_lp ? "kurasera_home" : "application"
- unless home_care_lp
  link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
link href="https://fonts.googleapis.com/css2?family=Klee+One:wght@400;600&family=Noto+Sans+JP:wght@300;400;700;900&display=swap" rel="stylesheet"
= stylesheet_link_tag lp_stylesheet, media: "all", "data-turbolinks-track": "reload"
= display_meta_tags
= favicon_link_tag "favicon.ico"

- if defined?(breadcrumbs) && breadcrumbs.present?
  script type="application/ld+json"
    = raw(breadcrumb_list_json_ld)

- if controller_name == "pages" && action_name == "index"
  script type="application/ld+json"
    = raw(organization_json_ld)
  script type="application/ld+json"
    = raw(website_json_ld)

- if controller_name == "pages" && %w[baby babysitter housekeeping living home_care].include?(action_name)
  - faq_ld = faq_page_json_ld(lp_faqs_for_current_page)
  - if faq_ld.present?
    script type="application/ld+json"
      = raw(faq_ld)

