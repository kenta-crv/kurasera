- top_home = controller_name == "pages" && action_name == "index"
- home_care_lp = controller_name == "pages" && action_name == "home_care"
doctype html
html lang="ja" class=(top_home ? "jw-top-page" : (home_care_lp ? "kslp-page" : nil))
  head
    = render "layouts/head"

    / --- canonical（各ドメイン用） ---
    - canonical_url = request.url
    link rel="canonical" href=canonical_url

  body
    - unless top_home || home_care_lp
      = render "layouts/header"

    - unless top_home || home_care_lp
      = render "shared/breadcrumbs" if breadcrumbs.any?

    - if params[:sent] == '1'
      .flash-message.alert.alert-success role="alert"
        - if home_care_lp
          | 送信が完了しました。内容を info@j-work.jp に通知しました。
        - else
          | 送信完了しました

      script
        |
          gtag('event', 'conversion', {
              'send_to': 'AW-10998015402/P0wGCMmaqZQcEKrLofwo',
              'value': 1.0,
              'currency': 'JPY'
          });
          ytag({
            "type":"yjad_conversion",
            "config":{
              "yahoo_ydn_conv_io": "sExy6wrWFcaJvWNk_H95ZA..",
              "yahoo_ydn_conv_label": "OOWU7PJ9D37IA8DZF21378038",
              "yahoo_ydn_conv_transaction_id": "",
              "yahoo_ydn_conv_value": "0"
            }
          });
          (function () {
            var flash = document.querySelector('.flash-message');
            if (!flash) return;
            setTimeout(function () {
              flash.style.transition = 'opacity 0.5s ease';
              flash.style.opacity = '0';
              setTimeout(function () { flash.remove(); }, 500);
            }, 3000);
          })();

    - flash.each do |type, message|
      - tag_class = (type == 'notice' ? 'success' : 'danger')
      div class="flash-message alert alert-#{tag_class}" role="alert"
        = message

    main class=(top_home ? "jw-top-main" : (home_care_lp ? "kslp-main" : nil))
      = yield

    - unless top_home || home_care_lp
      footer.ks-footer
        .ks-footer__inner
          p.ks-footer__heading サービス・コンテンツ
          ul.ks-footer__list
            li = link_to "トップ", root_path, data: { turbolinks: false }
            li = link_to "暮らしサポート", living_path, data: { turbolinks: false }
            li = link_to "お役立ち記事", "/columns", data: { turbolinks: false }
            li = link_to "ベビーシッター", baby_path, data: { turbolinks: false }
            li = link_to "外国人シッター", babysitter_path, data: { turbolinks: false }
            li = link_to "家事代行", housekeeping_path, data: { turbolinks: false }
        p.ks-footer__copy &copy; #{Time.current.year} 株式会社J Work / kurasera.life

    = javascript_include_tag "application", "data-turbolinks-track": "reload"
