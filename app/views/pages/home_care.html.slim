        var min = PREF_WAGES[0].wage;
        for (var i = 1; i < PREF_WAGES.length; i++) {
          if (PREF_WAGES[i].wage < min) min = PREF_WAGES[i].wage;
        }
        return min;
      }

      function planFromDays(days) {
        if (days <= 1) return 'small';
        if (days <= 3) return 'standard';
        return 'premium';
      }

      function prefFromAddress(address) {
        var text = address || '';
        var match = null;
        PREF_WAGES.forEach(function (pref) {
          if (text.indexOf(pref.name) !== -1) {
            if (!match || pref.name.length > match.name.length) match = pref;
          }
        });
        return match;
      }

      var weeklySelect = document.getElementById('kh-weekly-days');
      var hoursSelect = document.getElementById('kh-daily-hours');
      var addressInput = document.getElementById('kh-form-address');
      var nameInput = document.getElementById('kh-form-name');
      var telInput = document.getElementById('kh-form-tel');
      var periodSelect = document.getElementById('kh-form-period');
      var estimateBox = document.getElementById('kh-form-estimate');
      var estimateHourly = document.getElementById('kh-form-estimate-hourly');
      var estimateArea = document.getElementById('kh-form-estimate-area');
      var estimateMonth = document.getElementById('kh-form-estimate-month');
      var quoteForm = document.getElementById('home-care-quote');
      var lineLink = document.getElementById('kh-form-line');
      var lineHint = document.getElementById('kh-form-line-hint');
      var quoteSteps = document.querySelectorAll('.kh-quote-steps__item');
      var latestQuote = null;

      function bindChoiceRow(selectEl) {
        if (!selectEl) return;
        var row = document.querySelector('[data-choice-for="' + selectEl.id + '"]');
        if (!row) return;
        var buttons = row.querySelectorAll('.kh-choice');
        function sync() {
          buttons.forEach(function (btn) {
            btn.classList.toggle('is-selected', btn.getAttribute('data-choice-value') === selectEl.value);
          });
        }
        buttons.forEach(function (btn) {
          btn.addEventListener('click', function () {
            selectEl.value = btn.getAttribute('data-choice-value');
            sync();
            selectEl.dispatchEvent(new Event('change'));
          });
        });
        selectEl.addEventListener('change', sync);
        sync();
      }

      function setQuoteStep(index) {
        quoteSteps.forEach(function (el, i) {
          el.classList.toggle('is-current', i === index);
          el.classList.toggle('is-done', i < index);
        });
      }

      function setLineReady(ready) {
        if (!lineLink) return;
        lineLink.classList.toggle('is-disabled', !ready);
        lineLink.setAttribute('aria-disabled', ready ? 'false' : 'true');
        lineLink.disabled = !ready;
      }

      function hasQuote() {
        return !!(weeklySelect && hoursSelect && parseInt(weeklySelect.value, 10) && parseInt(hoursSelect.value, 10));
      }

      function formReadyToSubmit() {
        var nameOk = nameInput && nameInput.value.trim() !== '';
        var telOk = telInput && telInput.value.trim() !== '';
        var periodOk = periodSelect && periodSelect.value !== '';
        var addressOk = addressInput && addressInput.value.trim() !== '';
        return hasQuote() && nameOk && telOk && periodOk && addressOk;
      }

      function updateLineButton() {
        var ready = formReadyToSubmit();
        setLineReady(ready);
        if (!lineHint) return;
        if (ready) {
          lineHint.hidden = true;
          return;
        }
        lineHint.hidden = false;
        if (!hasQuote()) {
          lineHint.textContent = '週の日数と時間を選ぶと送信できます。';
        } else {
          lineHint.textContent = 'お名前・電話番号と開始希望を入れると送信できます。';
        }
      }

      function dayLabel(days) {
        return days === 7 ? '毎日' : '週' + days + '日';
      }

      function renderFormEstimate() {
        if (!estimateBox || !weeklySelect || !hoursSelect) return;
        var days = parseInt(weeklySelect.value, 10);
        var hours = parseInt(hoursSelect.value, 10);
        if (!days || !hours) {
          latestQuote = null;
          estimateBox.classList.add('is-pending');
          estimateBox.classList.remove('is-ready');
          setQuoteStep(0);
          updateLineButton();
          return;
        }
        var pref = prefFromAddress(addressInput ? addressInput.value : '');
        var wage = pref ? pref.wage : minWage();
        var area = pref ? pref.name : '全国（最安の単価）';
        var hourly = calcHourly(wage, planFromDays(days));
        var monthly = hourly * hours * days * 4;
        latestQuote = { days: days, hours: hours, hourly: hourly, monthly: monthly, area: area };
        if (estimateHourly) estimateHourly.textContent = formatYen(hourly);
        if (estimateArea) estimateArea.textContent = area;
        if (estimateMonth) {
          estimateMonth.textContent = '月額 ' + formatYen(monthly) + '円（' + dayLabel(days) + '×' + hours + '時間×4週）';
        }
        estimateBox.classList.remove('is-pending');
        estimateBox.classList.add('is-ready');
        setQuoteStep(1);
        updateLineButton();
      }

      bindChoiceRow(weeklySelect);
      bindChoiceRow(hoursSelect);

      if (quoteForm) {
        quoteForm.addEventListener('submit', function (e) {
          if (!quoteForm.reportValidity() || !latestQuote || !formReadyToSubmit()) {
            e.preventDefault();
            updateLineButton();
          }
        });
      }

      if (weeklySelect) weeklySelect.addEventListener('change', renderFormEstimate);
      if (hoursSelect) hoursSelect.addEventListener('change', renderFormEstimate);
      if (addressInput) addressInput.addEventListener('input', renderFormEstimate);
      if (nameInput) nameInput.addEventListener('input', updateLineButton);
      if (telInput) telInput.addEventListener('input', updateLineButton);
      if (periodSelect) periodSelect.addEventListener('change', updateLineButton);
      renderFormEstimate();

      if (!select || !baseAmount || !cards.length) return;

      function trackPrefSwitch(prefName) {
        var count = parseInt(localStorage.getItem(COUNT_KEY) || '0', 10) || 0;
        count += 1;
        localStorage.setItem(COUNT_KEY, String(count));
        if (typeof gtag === 'function') {
          gtag('event', 'prefecture_price_switch', {
            event_category: 'home_care',
            event_label: prefName || '未選択',
            value: count
          });
        }
      }

      function render(wage, label) {
        var cheapest = calcHourly(wage, 'premium');
        if (baseList) baseList.textContent = formatYen(cheapest + PRICE_MARKUP);
        baseAmount.textContent = formatYen(cheapest);
        baseNote.textContent = '（' + label + '）';
        if (compareAmount) compareAmount.textContent = formatYen(cheapest);
        cards.forEach(function (card) {
          var plan = card.getAttribute('data-plan');
          var price = calcHourly(wage, plan);
          var listPrice = price + PRICE_MARKUP;
          var tax = Math.round(price * 1.1);
          var listEl = card.querySelector('[data-price-list]');
          var amountEl = card.querySelector('[data-price-amount]');
          var taxEl = card.querySelector('[data-price-tax]');
          if (listEl) listEl.textContent = formatYen(listPrice);
          if (amountEl) amountEl.textContent = formatYen(price);
          if (taxEl) taxEl.textContent = '（税込 ' + formatYen(tax) + '円）';
        });
      }

      PREF_WAGES.forEach(function (pref) {
        var opt = document.createElement('option');
        opt.value = String(pref.wage);
        opt.textContent = pref.name;
        opt.setAttribute('data-name', pref.name);
        select.appendChild(opt);
      });

      render(minWage(), '全国');

      select.addEventListener('change', function () {
        var selected = select.options[select.selectedIndex];
        var wage = select.value ? parseInt(select.value, 10) : minWage();
        var label = select.value ? selected.textContent : '全国';
        render(wage, label);
        trackPrefSwitch(select.value ? selected.textContent : '');
      });
    })();

    (function initFaqSearch() {
      var root = document.querySelector('[data-faq-root]');
      var searchInput = document.querySelector('[data-faq-search]');
      var items = document.querySelectorAll('.kh-faq__item');
      if (!searchInput || !items.length) return;
      var categoryBtns = root ? root.querySelectorAll('[data-faq-category]') : [];
      var activeCategory = '';
      function applyFilters() {
        var q = searchInput.value.trim().toLowerCase();
        items.forEach(function(item) {
          var category = item.getAttribute('data-faq-item') || '';
          var text = item.textContent.toLowerCase();
          var matchCategory = !activeCategory || category === activeCategory;
          var matchSearch = !q || text.indexOf(q) !== -1;
          item.classList.toggle('is-hidden', !(matchCategory && matchSearch));
          item.style.display = (matchCategory && matchSearch) ? '' : 'none';
        });
      }
      function setCategory(category) {
        activeCategory = category;
        categoryBtns.forEach(function(btn) {
          btn.classList.toggle('is-active', btn.getAttribute('data-faq-category') === category);
        });
        items.forEach(function(item) {
          if (item.open && item.getAttribute('data-faq-item') !== category) {
            item.open = false;
          }
        });
        applyFilters();
      }
      categoryBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          setCategory(btn.getAttribute('data-faq-category'));
        });
      });
      searchInput.addEventListener('input', applyFilters);
      items.forEach(function(item) {
        item.addEventListener('toggle', function() {
          if (!item.open) return;
          items.forEach(function(other) {
            if (other !== item) other.open = false;
          });
        });
      });
      if (categoryBtns.length) {
        setCategory(categoryBtns[0].getAttribute('data-faq-category'));
      } else {
        applyFilters();
      }
    })();
