  header.kh-header
    .kh-container.kh-header__inner
      = link_to '#top', class: 'kh-brand', aria: { label: 'クラセラ トップへ' } do
        = image_tag 'logo.png', class: 'kh-brand__logo', alt: 'クラセラ'

      nav.kh-nav aria-label="メインナビゲーション"
        = link_to 'お悩み', '#service', class: 'kh-nav__link'
        = link_to '選ばれる理由', '#features', class: 'kh-nav__link'
        = link_to '料金の目安', '#price', class: 'kh-nav__link'
        = link_to 'ご利用の流れ', '#flow', class: 'kh-nav__link'
        = link_to 'よくあるご質問', '#faq', class: 'kh-nav__link'
        = link_to '法人のお客様', housekeeping_path, class: 'kh-nav__link', data: { turbolinks: false }

      button.kh-contact-button.kh-contact-button--header.kh-contact-button--line type="button" data-open-contact="true"
        span.kh-contact-button__icon aria-hidden="true"
          svg.kh-ico.kh-ico--solid
            use href="#kh-i-line"
        span.kh-contact-button__copy
          strong LINEで申し込む
          small 料金を確認する

  main
    section#top.kh-hero
      .kh-hero__image aria-hidden="true" style="--kh-hero-image: url(#{asset_path('housekeeping-image.png')})"
      .kh-container.kh-hero__inner
        .kh-hero__content
          p.kh-hero__eyebrow 家事代行サービス Kurasera
          h1.kh-hero__title
            | 掃除・洗濯・家事を
            br
            | まるごと
            em 代行します。
          p.kh-hero__lead
            | 週1回から、全国対応。
            br
            | ご自宅の家事を、経験のあるスタッフが引き受けます。

          ul.kh-hero__points
            li.kh-round-point
              span.kh-line-icon aria-hidden="true"
                svg.kh-ico
                  use href="#kh-i-calc"
              strong 業界最安値
              b 2,400円〜／時間
            li.kh-round-point
              span.kh-line-icon aria-hidden="true"
                svg.kh-ico
                  use href="#kh-i-calendar"
              strong 予定に合わせて
              b 週末だけ・毎日も
            li.kh-round-point
              span.kh-line-icon aria-hidden="true"
                svg.kh-ico
                  use href="#kh-i-heart-person"
              strong 全国対応
              b 地方でも利用可

    section#service.kh-concerns.kh-section
      .kh-container
        h2.kh-section-title
          | こんな
          em お悩み
          | はありませんか？

        .kh-concerns__grid
          article.kh-concern-card
            span.kh-concern-card__icon aria-hidden="true"
              svg.kh-ico
                use href="#kh-i-worry"
            p
              | 平日は仕事で精一杯。
              br
              | 家事まで手が回らない
          article.kh-concern-card
            span.kh-concern-card__icon aria-hidden="true"
              svg.kh-ico
                use href="#kh-i-crossed"
            p
              | せっかくの休日が
              br
              | 掃除と洗濯で消える
          article.kh-concern-card
            span.kh-concern-card__icon aria-hidden="true"
              svg.kh-ico
                use href="#kh-i-home"
            p
              | 水回りや散らかった部屋を
              br
              | プロの手で整えたい
          article.kh-concern-card
            span.kh-concern-card__icon aria-hidden="true"
              svg.kh-ico
                use href="#kh-i-calc"
            p
              | 今依頼しているが
              br
              | 金額が高い

        span.kh-concerns__arrow aria-hidden="true"

        .kh-concerns__answer
          .kh-concerns__content
            .kh-concerns__headline
              span.kh-concerns__lead そのお悩み、
              span.kh-concerns__badge 家事代行
            .kh-concerns__brand-row
              span.kh-concerns__mark aria-hidden="true"
                svg.kh-ico
                  use href="#kh-i-home"
              strong.kh-concerns__brand Kurasera
              span.kh-concerns__suffix がすべて
              em.kh-concerns__solve 解決
              span.kh-concerns__suffix します。
          .kh-concerns__visual
            .kh-concerns__visual-frame
              = image_tag 'feature-pro.jpg', alt: '', class: 'kh-concerns__visual-img'
            span.kh-concerns__deco.kh-concerns__deco--sparkle aria-hidden="true"
              svg viewBox="0 0 24 24" fill="currentColor"
                path d="M12 0l3 9 9 3-9 3-3 9-3-9-9-3 9-3z"
            span.kh-concerns__deco.kh-concerns__deco--chat aria-hidden="true"
              svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
            span.kh-concerns__deco.kh-concerns__deco--chart aria-hidden="true"
              svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                line x1="18" y1="20" x2="18" y2="10"
                line x1="12" y1="20" x2="12" y2="4"
                line x1="6" y1="20" x2="6" y2="14"

    section#features.kh-features.kh-section
      .kh-container
        p.kh-section-kicker 任せた翌日から、暮らしが軽くなる。
        h2.kh-heading
          | Kuraseraが
          br
          em 選ばれる
          | 理由
        p.kh-heading-lead
          | 家事を外に出すことを、一部の人の贅沢ではなく、普通の暮らしで続けられるようにしています。

        .kh-features__grid
          article.kh-feature-card
            .kh-feature-card__body
              .kh-feature-card__meta
                span.kh-feature-card__icon aria-hidden="true"
                  svg.kh-ico
                    use href="#kh-i-sparkle"
                span.kh-feature-card__number 01
              h3 経験豊富な家事のプロ
              p 家事経験のあるスタッフが担当します。ご依頼の掃除・洗濯・片付けを進めます。
            = image_tag 'feature-pro.jpg', class: 'kh-feature-card__image', alt: '丁寧に家事を行う経験豊富なスタッフ', loading: 'lazy'
          article.kh-feature-card
            .kh-feature-card__body
              .kh-feature-card__meta
                span.kh-feature-card__icon aria-hidden="true"
                  svg.kh-ico
                    use href="#kh-i-team"
                span.kh-feature-card__number 02
              h3 あなたの予定に合わせて対応
              p
                | 平日夕方や休日午前など、忙しい時間にも対応。
                br
                | 訪問の曜日と時間を組めます。
            = image_tag 'feature-flexible.jpg', class: 'kh-feature-card__image', alt: '早朝・夕方など柔軟な時間に訪問する家事スタッフ', loading: 'lazy'
          article.kh-feature-card
            .kh-feature-card__body
              .kh-feature-card__meta
                span.kh-feature-card__icon aria-hidden="true"
                  svg.kh-ico
                    use href="#kh-i-shield"
                span.kh-feature-card__number 03
              h3 日本全国でご利用可能
              p 東京・大阪などの主要都市に限りません。地方を含む日本全国で、家事代行をご依頼いただけます。
            = image_tag 'feature-nationwide.jpg', class: 'kh-feature-card__image', alt: 'ご自宅で安心してお任せいただけるスタッフ', loading: 'lazy'

    section#price.kh-price.kh-section
      .kh-container
        p.kh-section-kicker まずは試しやすい料金から
        h2.kh-heading
          em 料金
          | のご案内
        p.kh-heading-lead 週1回のお試しから、毎日のフルサポートまで。ご予算と頻度に合わせて選べます。

        h3.kh-subheading 選べる3つの料金プラン
        .kh-price__controls
          label.kh-price__pref-label for="kh-pref-select"
            span 都道府県を選択
            select#kh-pref-select.kh-price__pref-select
              option value="" selected="selected" 全国（最安値）
          p.kh-price__base
            span.kh-price__campaign キャンペーン価格
            span.kh-price__base-copy
              | ベースは最安値で
              s#kh-price-base-list —
              strong#kh-price-base-amount —
              | 円〜
            small#kh-price-base-note （全国）
        .kh-price__grid#kh-price-grid
          article.kh-price-card data-plan="small" data-plan-extra="1200"
            header.kh-price-card__header
              h4 スモールプラン
              p 気になるところだけ、短時間で整えたい週に
            .kh-price-card__body
              p.kh-price-card__amount
                s data-price-list="true" —
                strong.kh-price-card__sale data-price-amount="true" —
                span 円〜／時間
              small data-price-tax="true" —
              ul.kh-price-card__specs
                li
                  span.kh-spec-ico aria-hidden="true"
                    svg.kh-ico
                      use href="#kh-i-calendar"
                  b 頻度
                  span 週1回
                li
                  span.kh-spec-ico aria-hidden="true"
                    svg.kh-ico
                      use href="#kh-i-clock"
                  b 時間の目安
                  span 1日2時間から
                li
                  span.kh-spec-ico aria-hidden="true"
                    svg.kh-ico
                      use href="#kh-i-person"
                  b スタッフ
                  span 1名体制
                li
                  span.kh-spec-ico aria-hidden="true"
                    svg.kh-ico
                      use href="#kh-i-home"
                  b おすすめ
                  span 短時間から
              button.kh-outline-button type="button" data-open-contact="true" 金額目安を見る

          article.kh-price-card.kh-price-card--featured data-plan="standard" data-plan-extra="1100"
            span.kh-price-card__badge 人気No.1
            header.kh-price-card__header
              h4 スタンダードプラン
              p 家事の負担を大きく減らしたい方へ
            .kh-price-card__body
              p.kh-price-card__amount
                s data-price-list="true" —
                strong.kh-price-card__sale data-price-amount="true" —
                span 円〜／時間
              small data-price-tax="true" —
              ul.kh-price-card__specs
                li
                  span.kh-spec-ico aria-hidden="true"
                    svg.kh-ico
                      use href="#kh-i-calendar"
                  b 頻度
                  span 週3回
                li
                  span.kh-spec-ico aria-hidden="true"
                    svg.kh-ico
                      use href="#kh-i-clock"
                  b 時間の目安
                  span 1日5時間から
                li
                  span.kh-spec-ico aria-hidden="true"
                    svg.kh-ico
                      use href="#kh-i-people"
                  b スタッフ
                  span 1名体制
                li
                  span.kh-spec-ico aria-hidden="true"
                    svg.kh-ico
                      use href="#kh-i-home"
                  b おすすめ
                  span 共働き世帯の定番
              button.kh-outline-button.kh-outline-button--filled type="button" data-open-contact="true" 金額目安を見る

          article.kh-price-card data-plan="premium" data-plan-extra="1000"
            header.kh-price-card__header
              h4 プレミアムプラン
              p 広いお宅や、毎日の家事をまるごと任せたい方へ
            .kh-price-card__body
              p.kh-price-card__amount
                s data-price-list="true" —
                strong.kh-price-card__sale data-price-amount="true" —
                span 円〜／時間
              small data-price-tax="true" —
              ul.kh-price-card__specs
                li
                  span.kh-spec-ico aria-hidden="true"
                    svg.kh-ico
                      use href="#kh-i-calendar"
                  b 頻度
                  span 週5回
                li
                  span.kh-spec-ico aria-hidden="true"
                    svg.kh-ico
                      use href="#kh-i-clock"
                  b 時間の目安
                  span 1日7時間から
                li
                  span.kh-spec-ico aria-hidden="true"
                    svg.kh-ico
                      use href="#kh-i-people"
                  b スタッフ
                  span 1〜2名体制
                li
                  span.kh-spec-ico aria-hidden="true"
                    svg.kh-ico
                      use href="#kh-i-home"
                  b おすすめ
                  span 手厚いサポート希望
              button.kh-outline-button type="button" data-open-contact="true" 金額目安を見る

        p.kh-price__note
          | ※交通費実費は別途発生します。
          br
          | ※時間や曜日指定により料金が変動する場合があります。
          br
          | ※お支払いはクレジットカードのみです。請求書払いには対応していません。

    section#compare.kh-compare-section.kh-section
      .kh-container
        p.kh-section-kicker 公開情報をもとにした目安
        h2.kh-heading
          | 他社との
          em 料金比較
        p.kh-heading-lead 同じ家事代行でも、時間単価はKuraseraが抑えめです。

        .kh-compare
          table.kh-compare__table
            colgroup
              col.kh-compare__item-col
              col
              col
              col
              col.kh-compare__ours-col
            thead
              tr
                th 項目
                th scope="col"
                  span.kh-compare__name CaSy
                th scope="col"
                  span.kh-compare__name Cat Hand
                th scope="col"
                  span.kh-compare__name C社
                th.kh-compare__ours scope="col"
                  span.kh-compare__badge 最安
                  span.kh-compare__name Kurasera
            tbody
              tr
                th scope="row" 定期料金
                td 2,790円/時
                td 3,388円/時
                td 3,245円〜/時
                td.kh-compare__ours
                  p.kh-compare__rate
                    strong#kh-compare-ours-amount —
                    small 円/時
              tr
                th scope="row" 最低利用時間
                td 2時間
                td 2時間
                td 3時間
                td.kh-compare__ours 2時間から
              tr
                th scope="row" 交通費
                td 880円
                td 900円
                td 990円
                td.kh-compare__ours 実費
              tr
                th scope="row" 備考
                td マッチング型
                td お試しあり
                td 大手・専任制
                td.kh-compare__ours 全国対応

    section#reviews.kh-reviews.kh-section
