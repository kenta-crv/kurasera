- set_meta_tags title: "暮らしのサポートなら『Kurasera』｜ベビーシッター・家事代行"
- set_meta_tags description: "ベビーシッター・英語ができる外国人シッター・家事代行まで。暮らしを支えるサービスなら『Kurasera』にお任せください。"

.sp-corp-wrapper.jw-platform
  header.jw-top-header
    .jw-top-header__inner
      = link_to root_path, class: "jw-top-header__logo", data: { turbolinks: false } do
        = image_tag "logo2.png", alt: "Kurasera", class: "jw-top-header__logo-img", width: "150", height: "54"
      nav.jw-top-header__nav
        = link_to "暮らしサポート", living_path, data: { turbolinks: false }
        = link_to "家事代行", housekeeping_path, data: { turbolinks: false }
        = link_to "お役立ち記事", "/columns", data: { turbolinks: false }
        = link_to "お問い合わせ", living_path(anchor: "inquiry"), data: { turbolinks: false }

  section.jw-hero
    .jw-hero__grid
      .jw-hero__copy
        h1
          | 育児も家事も、
          br
          | 信頼できるプロに任せる
        p.jw-hero__stats-text
          | ベビーシッター・家事代行なら
          span.jw-hero__num Kurasera
        .jw-hero__cta
          = link_to "サービスを見る", living_path, class: "jw-btn jw-btn--primary", data: { turbolinks: false }
          = link_to "家事代行を依頼", housekeeping_path, class: "jw-btn jw-btn--ghost", data: { turbolinks: false }
      .jw-hero__visual
        = image_tag "babysitter-image1.png", alt: "暮らしを支えるスタッフ"

  .jw-main
    section.jw-doors
      .jw-door-grid
        article.jw-door
          p.jw-door__label
            span.jw-door__num 1
            | 暮らしサポート
          .jw-door__icon aria-hidden="true"
            svg viewBox="0 0 64 64" width="64" height="64"
              rect x="12" y="24" width="40" height="28" rx="3" fill="#1a73e8"
              polygon points="32,10 8,26 12,26 12,24 52,24 52,26 56,26" fill="#3d8bfd"
              rect x="28" y="36" width="8" height="16" fill="#fff"
          h2 総合のご案内
          p ベビーシッターから家事代行まで。暮らしの負担を軽くするサービスをご紹介します。
          = link_to "詳しく見る  ›", living_path, class: "jw-door__btn", data: { turbolinks: false }

        article.jw-door
          p.jw-door__label
            span.jw-door__num 2
            | 家事代行
          .jw-door__icon aria-hidden="true"
            svg viewBox="0 0 64 64" width="64" height="64"
              rect x="14" y="18" width="36" height="32" rx="4" fill="#e8f1ff"
              rect x="14" y="18" width="36" height="32" rx="4" stroke="#1a73e8" stroke-width="3" fill="none"
              circle cx="32" cy="34" r="8" fill="#1a73e8"
              rect x="28" y="42" width="8" height="8" fill="#3d8bfd"
          h2 ハウスキーピング
          p 掃除・洗濯・整理整頓まで。忙しい毎日を支える家事代行です。
          = link_to "詳しく見る  ›", housekeeping_path, class: "jw-door__btn", data: { turbolinks: false }

        article.jw-door
          p.jw-door__label
            span.jw-door__num 3
            | お役立ち記事
          .jw-door__icon aria-hidden="true"
            svg viewBox="0 0 64 64" width="64" height="64"
              rect x="14" y="8" width="36" height="48" rx="4" fill="#e8f1ff"
              rect x="14" y="8" width="36" height="48" rx="4" stroke="#1a73e8" stroke-width="3" fill="none"
              rect x="22" y="20" width="20" height="3" rx="1.5" fill="#1a73e8"
              rect x="22" y="28" width="20" height="3" rx="1.5" fill="#1a73e8"
              rect x="22" y="36" width="14" height="3" rx="1.5" fill="#8bb4f5"
          h2 暮らすをサポート
          p 育児・家事のヒントやサービス選びのポイントをまとめています。
          = link_to "記事を読む  ›", "/columns", class: "jw-door__btn jw-door__btn--ghost", data: { turbolinks: false }

    ul.jw-stats
      li
        .jw-stats__icon aria-hidden="true"
          svg viewBox="0 0 48 48" width="40" height="40"
            circle cx="16" cy="16" r="6" fill="#1a73e8"
            circle cx="32" cy="16" r="6" fill="#3d8bfd"
            path d="M6 36c1.5-7 6-11 10-11s8.5 4 10 11" fill="#1a73e8"
            path d="M22 36c1.5-7 6-11 10-11s8.5 4 10 11" fill="#3d8bfd"
        div
          strong 厳選スタッフ
          span 独自審査を通過した人材
      li
        .jw-stats__icon aria-hidden="true"
          svg viewBox="0 0 48 48" width="40" height="40"
            rect x="8" y="26" width="8" height="14" rx="2" fill="#8bb4f5"
            rect x="20" y="18" width="8" height="22" rx="2" fill="#3d8bfd"
            rect x="32" y="10" width="8" height="30" rx="2" fill="#1a73e8"
        div
          strong 3つのサービス
          span シッター・外国人・家事代行
      li
        .jw-stats__icon aria-hidden="true"
          svg viewBox="0 0 48 48" width="40" height="40"
            path d="M24 6c-8 0-14 6-14 14 0 10 14 22 14 22s14-12 14-22c0-8-6-14-14-14z" fill="#1a73e8"
            circle cx="24" cy="20" r="5" fill="#fff"
        div
          strong 全国対応
          span スポットから定期まで

    .sp-company
      .sp-company-inner
        h2 会社概要
        .sp-table
          .sp-row
            .sp-th 会社名
            .sp-td 株式会社J Work
          .sp-row
            .sp-th 代表取締役
            .sp-td 奥山　健太
          .sp-row
            .sp-th 資本金
            .sp-td 5,000,000円
          .sp-row
            .sp-th 所在地
            .sp-td 東京都港区浜松町２丁目２番１５号２Ｆ

  footer.jw-footer
    .jw-footer__inner
      p.jw-footer__heading サービス
      ul.jw-footer__list
        li = link_to "トップ", root_path, data: { turbolinks: false }
        li = link_to "暮らしサポート", living_path, data: { turbolinks: false }
        li = link_to "ベビーシッター", baby_path, data: { turbolinks: false }
        li = link_to "外国人シッター", babysitter_path, data: { turbolinks: false }
        li = link_to "家事代行", housekeeping_path, data: { turbolinks: false }
        li = link_to "お役立ち記事", "/columns", data: { turbolinks: false }
    p.jw-footer__copy &copy; #{Time.current.year} 株式会社J Work / kurasera.life
